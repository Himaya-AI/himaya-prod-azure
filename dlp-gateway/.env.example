# DLP Gateway — local development defaults

SMTP_TLS_CERT_FILE=/certs/fullchain.pem
SMTP_TLS_KEY_FILE=/certs/privkey.pem
SMTP_REQUIRE_STARTTLS=true
DLP_ENV=staging
LOG_LEVEL=INFO

SMTP_HOST=0.0.0.0
SMTP_PORT=2525
HEALTH_HOST=0.0.0.0
HEALTH_PORT=8080

SPOOL_DIR=/var/dlp/spool
DATA_DIR=/var/dlp/data
QUEUE_DIR=/var/dlp/queues
QUEUE_RECLAIM_SECONDS=300
TENANT_CONFIG_PATH=/app/conf/tenants/local-tenant.json

# Local Docker uses filesystem. For AWS → Azure control-plane queues, use
# service_bus, set FORCE_ALLOW=false, and provide one credential option below.
MESSAGE_BUS=filesystem
SERVICE_BUS_CONNECTION_STRING=
SERVICE_BUS_FULLY_QUALIFIED_NAMESPACE=
CAPTURE_QUEUE_NAME=dlp-capture
COMMAND_QUEUE_NAME=dlp-commands
DELIVERY_QUEUE_NAME=dlp-delivery

# Local mode: publish allow command automatically after capture
FORCE_ALLOW=true

# Azurite Blob
AZURE_STORAGE_CONNECTION_STRING=DefaultEndpointsProtocol=http;AccountName=devstoreaccount1;AccountKey=Eby8vdM02xNOcqFlqUwJPLlmEtlCDXJ1OUzFT50uSRZ6IFsuFq2UVErCz4I6tq/K1SZFPTOtr/KBHBeksoGMGw==;BlobEndpoint=http://azurite:10000/devstoreaccount1;
BLOB_CONTAINER=dlp-mime

# Default local sink (used when tenant relay.adapter=local)
RELAY_HOST=mailhog
RELAY_PORT=1025
RELAY_USE_TLS=false
RELAY_MAX_ATTEMPTS=4

# For Microsoft return on AWS staging:
# 1) Copy conf/tenants/staging-m365.json.example -> local-tenant.json (or point TENANT_CONFIG_PATH)
# 2) Mount client cert/key into the container (separate from SMTP ingress cert)
# 3) Set relay.adapter=microsoft and mx_host=sana085.mail.protection.outlook.com

MAX_MESSAGE_BYTES=26214400
MAX_RECIPIENTS=100
